{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anonymous-fishbowl",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "FishbowlRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FishbowlRoom"
      ]
    }
  ]
}